# Copiar a infra/.env y rellenar. El .env real NO se commitea.
#
#   cp infra/.env.example infra/.env
#   nano infra/.env

# Dominio base del proyecto. Los subdominios churn.<DOMAIN_BASE> y
# mlflow.<DOMAIN_BASE> deben apuntar por registro A a la IP del VPS.
DOMAIN_BASE=juanitodev.com

# Credenciales de PostgreSQL (backend store de MLflow).
# La base no se expone al exterior, pero usa una contraseña larga igualmente:
# vive en el mismo host que el resto y no cuesta nada.
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=cambiame-por-algo-largo-y-aleatorio
POSTGRES_DB=mlflow
